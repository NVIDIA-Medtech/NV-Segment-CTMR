{
    "imports": [
        "$import numpy as np",
        "$import scripts"
    ],
    "bundle_root": ".",
    "checkpoint_path": "$@bundle_root + '/models/model_softmax.pt'",
    "input_file": "/data/Task09_Spleen/imagesTr/spleen_10.nii.gz",
    "output_dir": "$@bundle_root + '/eval'",
    "output_postfix": "seg",
    "image_key": "image",
    "input_channels": 1,
    "device": "$torch.device('cuda:0' if torch.cuda.is_available() else 'cpu')",
    "amp": true,
    "patch_size": [
        128,
        128,
        128
    ],
    "resample_to_spacing": [
        1.5,
        1.5,
        1.5
    ],
    "label_mappings": {
        "default": [
            [
                1,
                3
            ]
        ]
    },
    "class_ids": "$[mapping[1] for mapping in @label_mappings#default]",
    "output_label_mappings": "${'default': [[channel + 1, mapping[0]] for channel, mapping in enumerate(@label_mappings#default)]}",
    "network_def": {
        "_target_": "scripts.vista3d_softmax.Vista3dSoftmax",
        "in_channels": "@input_channels",
        "class_ids": "@class_ids"
    },
    "network": "$@network_def.to(@device)",
    "preprocessing": {
        "_target_": "Compose",
        "transforms": [
            {
                "_target_": "LoadImaged",
                "keys": "@image_key",
                "image_only": true,
                "ensure_channel_first": true
            },
            {
                "_target_": "CropForegroundd",
                "keys": "@image_key",
                "source_key": "@image_key",
                "margin": 10,
                "allow_smaller": true,
                "start_coord_key": null,
                "end_coord_key": null
            },
            {
                "_target_": "ScaleIntensityRangePercentilesd",
                "keys": "@image_key",
                "lower": 1,
                "upper": 99,
                "b_min": 0,
                "b_max": 1,
                "clip": true
            },
            {
                "_target_": "Orientationd",
                "keys": "@image_key",
                "axcodes": "RAS"
            },
            {
                "_target_": "Spacingd",
                "keys": "@image_key",
                "pixdim": "@resample_to_spacing",
                "mode": "bilinear"
            },
            {
                "_target_": "CastToTyped",
                "keys": "@image_key",
                "dtype": "$torch.float32"
            },
            {
                "_target_": "EnsureTyped",
                "keys": "@image_key",
                "track_meta": true
            },
            {
                "_target_": "SpatialPadd",
                "keys": "@image_key",
                "spatial_size": "@patch_size",
                "mode": "constant"
            }
        ]
    },
    "dataset": {
        "_target_": "Dataset",
        "data": "$[{'image': @input_file}]",
        "transform": "@preprocessing"
    },
    "dataloader": {
        "_target_": "ThreadDataLoader",
        "dataset": "@dataset",
        "batch_size": 1,
        "shuffle": false,
        "num_workers": 0
    },
    "inferer": {
        "_target_": "SlidingWindowInferer",
        "roi_size": "@patch_size",
        "sw_batch_size": 1,
        "overlap": 0.625,
        "mode": "gaussian"
    },
    "postprocessing": {
        "_target_": "Compose",
        "transforms": [
            {
                "_target_": "AsDiscreted",
                "keys": "pred",
                "argmax": true
            },
            {
                "_target_": "monai.apps.vista3d.transforms.Relabeld",
                "keys": "pred",
                "label_mappings": "@output_label_mappings",
                "dtype": "$torch.uint8"
            },
            {
                "_target_": "Invertd",
                "keys": "pred",
                "transform": "@preprocessing",
                "orig_keys": "@image_key",
                "nearest_interp": true,
                "to_tensor": true
            },
            {
                "_target_": "SaveImaged",
                "keys": "pred",
                "resample": false,
                "output_dir": "@output_dir",
                "output_dtype": "$np.uint8",
                "output_postfix": "@output_postfix",
                "separate_folder": true
            }
        ]
    },
    "handlers": [
        {
            "_target_": "StatsHandler",
            "iteration_log": false
        }
    ],
    "checkpointloader": {
        "_target_": "CheckpointLoader",
        "load_path": "@checkpoint_path",
        "load_dict": {
            "model": "@network"
        },
        "map_location": "@device"
    },
    "evaluator": {
        "_target_": "SupervisedEvaluator",
        "device": "@device",
        "val_data_loader": "@dataloader",
        "network": "@network",
        "inferer": "@inferer",
        "postprocessing": "@postprocessing",
        "key_val_metric": null,
        "additional_metrics": null,
        "val_handlers": "@handlers",
        "amp": "@amp"
    },
    "initialize": [
        "$monai.utils.set_determinism(seed=123)",
        "$@checkpointloader(@evaluator)"
    ],
    "run": [
        "$@evaluator.run()"
    ]
}
